source "https://rubygems.org"

# GitHub Pages (legacy build) builds with the github-pages gem, so pin the
# same gem locally to keep local and live output identical.
gem "github-pages", group: :jekyll_plugins

group :jekyll_plugins do
  gem "jekyll-feed"
  gem "jekyll-sitemap"
end

gem "webrick"

# Former stdlib gems that Jekyll 3.x still requires on Ruby >= 3.4.
gem "csv"
gem "base64"
gem "bigdecimal"
gem "logger"
